<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PaymentException" targetNamespace="http://payment-exception-frontend/processes">
  <bpmn:collaboration id="Collaboration_PaymentException">
    <bpmn:participant id="Participant_Process" name="Payment Exception Management" processRef="Process_PaymentException" />
  </bpmn:collaboration>
  <bpmn:process id="Process_PaymentException" name="Payment Exception Lifecycle" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Main">
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>StartEvent_ExceptionDetected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Categorize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoAssign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Assigned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UnassignedQueue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateAudit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Closed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Supervisor" name="Supervisor">
        <bpmn:flowNodeRef>Task_ManualAssign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewEscalation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Close</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Analyst" name="Operations Analyst">
        <bpmn:flowNodeRef>Task_Investigate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InfoAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_InfoReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Escalation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProposeResolution</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_ExceptionDetected" name="Exception detected">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Validate" name="Validate source data">
      <bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Task_Categorize" name="Categorize and prioritize">
      <bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="Task_AutoAssign" name="Apply assignment rules">
      <bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Assigned" name="Owner found?">
      <bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing><bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_UnassignedQueue" name="Place in unassigned queue">
      <bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_ManualAssign" name="Assign owner">
      <bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Investigate" name="Investigate exception">
      <bpmn:incoming>Flow_5</bpmn:incoming><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_InfoAvailable" name="Information complete?">
      <bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing><bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_RequestInfo" name="Request information">
      <bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Event_InfoReceived" name="Information received">
      <bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_Escalation" name="Escalation required?">
      <bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing><bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ReviewEscalation" name="Review escalation">
      <bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Approve" name="Proceed with resolution?">
      <bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing><bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ProposeResolution" name="Record resolution">
      <bpmn:incoming>Flow_15</bpmn:incoming><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Return" name="Return for rework">
      <bpmn:incoming>Flow_22</bpmn:incoming><bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ResolutionValid" name="Resolution valid?">
      <bpmn:incoming>Flow_19</bpmn:incoming><bpmn:outgoing>Flow_20</bpmn:outgoing><bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Close" name="Approve and close">
      <bpmn:incoming>Flow_20</bpmn:incoming><bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_UpdateAudit" name="Update audit and reporting">
      <bpmn:incoming>Flow_21</bpmn:incoming><bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Closed" name="Exception closed">
      <bpmn:incoming>Flow_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_ExceptionDetected" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Validate" targetRef="Task_Categorize" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Categorize" targetRef="Task_AutoAssign" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_AutoAssign" targetRef="Gateway_Assigned" />
    <bpmn:sequenceFlow id="Flow_5" name="Yes" sourceRef="Gateway_Assigned" targetRef="Task_Investigate" />
    <bpmn:sequenceFlow id="Flow_6" name="No" sourceRef="Gateway_Assigned" targetRef="Task_UnassignedQueue" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_UnassignedQueue" targetRef="Task_ManualAssign" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_ManualAssign" targetRef="Task_Investigate" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Investigate" targetRef="Gateway_InfoAvailable" />
    <bpmn:sequenceFlow id="Flow_10" name="No" sourceRef="Gateway_InfoAvailable" targetRef="Task_RequestInfo" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Event_InfoReceived" targetRef="Task_Investigate" />
    <bpmn:sequenceFlow id="Flow_12" name="Yes" sourceRef="Gateway_InfoAvailable" targetRef="Gateway_Escalation" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_RequestInfo" targetRef="Event_InfoReceived" />
    <bpmn:sequenceFlow id="Flow_14" name="Yes" sourceRef="Gateway_Escalation" targetRef="Task_ReviewEscalation" />
    <bpmn:sequenceFlow id="Flow_15" name="No" sourceRef="Gateway_Escalation" targetRef="Task_ProposeResolution" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_ReviewEscalation" targetRef="Gateway_Approve" />
    <bpmn:sequenceFlow id="Flow_17" name="More investigation" sourceRef="Gateway_Approve" targetRef="Task_Investigate" />
    <bpmn:sequenceFlow id="Flow_18" name="Resolve" sourceRef="Gateway_Approve" targetRef="Task_ProposeResolution" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_ProposeResolution" targetRef="Gateway_ResolutionValid" />
    <bpmn:sequenceFlow id="Flow_20" name="Yes" sourceRef="Gateway_ResolutionValid" targetRef="Task_Close" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_Close" targetRef="Task_UpdateAudit" />
    <bpmn:sequenceFlow id="Flow_22" name="No" sourceRef="Gateway_ResolutionValid" targetRef="Task_Return" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_Return" targetRef="Task_Investigate" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_UpdateAudit" targetRef="EndEvent_Closed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_PaymentException">
    <bpmndi:BPMNPlane id="BPMNPlane_PaymentException" bpmnElement="Collaboration_PaymentException">
      <bpmndi:BPMNShape id="Participant_Process_di" bpmnElement="Participant_Process" isHorizontal="true"><dc:Bounds x="80" y="80" width="2100" height="600" /></bpmndi:BPMNShape>
