      <bpmndi:BPMNShape id="ProposeResolution_di" bpmnElement="Task_ProposeResolution"><dc:Bounds x="1530" y="520" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ResolutionValid_di" bpmnElement="Gateway_ResolutionValid" isMarkerVisible="true"><dc:Bounds x="1710" y="535" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Return_di" bpmnElement="Task_Return"><dc:Bounds x="1690" y="315" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Close_di" bpmnElement="Task_Close"><dc:Bounds x="1840" y="315" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Audit_di" bpmnElement="Task_UpdateAudit"><dc:Bounds x="1840" y="128" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="EndEvent_Closed"><dc:Bounds x="2040" y="150" width="36" height="36" /></bpmndi:BPMNShape>
